# Copia este fichero a .env y rellena la clave.
# No subas .env al repositorio.

OPENAI_API_KEY=

# Modelo por defecto: barato y suficiente para clasificar candidatos.
OPENAI_MODEL=gpt-5.6-luna

# Otras opciones (misma variable; descomenta una y comenta la de arriba):
# OPENAI_MODEL=gpt-5.6-terra    # más capaz, más caro; si Luna se confunde mucho
# OPENAI_MODEL=gpt-5.6-sol      # flagship; no hace falta para este pipeline
# OPENAI_MODEL=gpt-4.1-mini     # alternativa ligera de la familia 4.1
# OPENAI_MODEL=gpt-4.1          # más preciso que mini, más caro
# OPENAI_MODEL=gpt-4o-mini      # clásico, barato, structured outputs muy estables
